# ─────────────────────────────────────────────────────────────
# 复制为 .env 后填写。所有密钥请用随机生成，不要手写。
#   生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   或：      openssl rand -base64 32 | tr -d '/+=' | cut -c1-43
# ─────────────────────────────────────────────────────────────

# ── 对外域名 ──────────────────────────────────────────────
# Caddy 用它签发证书并按域名分流，最终对外地址是：
#   api.<PUBLIC_HOST>      推理入口（指向 LiteLLM）
#   console.<PUBLIC_HOST>  运维控制台
# 没有自有域名时可用 nip.io：<VM公网IP>.nip.io，例如 20.78.139.35.nip.io
PUBLIC_HOST=<VM公网IP>.nip.io

# ── GHCP Proxy ────────────────────────────────────────────
# Proxy 的入站密钥。⚠️ 只给 LiteLLM 用，绝不下发给最终用户。
API_KEY=<随机32字节>
# 服务间内部调用令牌（Console/Login/SSO ↔ Proxy）
INTERNAL_API_TOKEN=<随机32字节>
# Console 会话签名密钥
SESSION_SECRET=<随机32字节>

LOG_LEVEL=info
STORAGE_DRIVER=sqlite
IDENTITY_HEADER_REQUIRED=true
CLAUDE_CODE_OPTIMIZED=true
ENTERPRISE_SHORTCODE=octo
REQUEST_STATS_PER_ACCOUNT_LIMIT=200
PROXY_PORT=3000
CONSOLE_PORT=7004

# 内部服务（3000/4000/7001/7003/7004）的端口绑定地址。
# 默认 127.0.0.1，只有宿主机自己能连，用于跑管理脚本和健康检查。
# 对外访问一律经 Caddy 的 80/443，无需改动此项。
BIND_ADDR=127.0.0.1

# ── SSO / Login ───────────────────────────────────────────
# 「导入已有 token」模式下这些值仅用于让容器启动，不代表可用的企业配置。
# 走「完整自动化」路线时必须换成客户真实的 EMU 企业配置。
SSO_PUBLIC_BASE_URL=http://sso:7001
SP_ENTITY_ID=https://github.com/enterprises/<企业slug>
SP_ACS_URL=https://github.com/enterprises/<企业slug>/saml/consume
ENTERPRISE_SLUG=<企业slug>
SCIM_BASE_URL=https://api.github.com/scim/v2/enterprises/<企业slug>
SCIM_TOKEN=<GitHub企业SCIM令牌>

# ── LiteLLM 网关层 ────────────────────────────────────────
# 管理密钥：建虚拟 key、查消费用它。仅管理员持有，不下发给最终用户。
LITELLM_MASTER_KEY=sk-<随机30字节>
# LiteLLM 的 PostgreSQL 密码
LITELLM_DB_PASSWORD=<随机24字节>
LITELLM_PORT=4000
# 管理后台（https://api.<域名>/ui/）的登录凭据。
# 不设则回落为 admin + LITELLM_MASTER_KEY；建议显式设置以便单独轮换。
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=<随机16字节>
